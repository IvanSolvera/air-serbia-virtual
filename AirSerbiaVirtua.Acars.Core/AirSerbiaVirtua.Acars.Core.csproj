<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AirSerbiaVirtua.Acars.Core</RootNamespace>
    <AssemblyName>AirSerbiaVirtua.Acars.Core</AssemblyName>
    <!-- FSUIPC7 (MSFS) is 64-bit; the IPC bridge requires x64. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FSUIPCClientDLL" Version="3.3.16" />
  </ItemGroup>

</Project>
