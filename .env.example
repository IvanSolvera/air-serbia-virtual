# Copy to ".env" next to docker-compose.yml on the server, then `chmod 600 .env`.
# NEVER commit the real .env. docker compose reads these for the api/migrator/db.

# Postgres password for the 'asv' role (used by db, api, and the migrator).
DB_PASSWORD=change-me-strong-password

# JWT signing key — 64+ random chars. Generate: openssl rand -base64 48
# Min 32 bytes enforced at API startup (fail-fast otherwise).
JWT_KEY=change-me-64-random-characters

# Public origin of the website, for the API CORS allow-list.
# Set to your real domain (https://). Only needed if the browser portal calls the
# API cross-origin; harmless to set regardless.
WEB_ORIGIN=https://your-domain.example
