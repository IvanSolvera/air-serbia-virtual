<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AirSerbiaVirtua.Acars.PoC</RootNamespace>
    <AssemblyName>AirSerbiaVirtua.Acars.PoC</AssemblyName>
    <!-- FSUIPC7 (MSFS) is 64-bit; build x64 so the IPC bridge matches. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Paul Henty's managed FSUIPC client. Auto-detects FSUIPC4/5/6 and FSUIPC7 (MSFS). -->
    <PackageReference Include="FSUIPCClientDLL" Version="3.3.16" />
  </ItemGroup>

</Project>
