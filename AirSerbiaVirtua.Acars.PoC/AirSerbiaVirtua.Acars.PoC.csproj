    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AirSerbiaVirtua.Acars.Core\AirSerbiaVirtua.Acars.Core.csproj" />
  </ItemGroup>

</Project>
