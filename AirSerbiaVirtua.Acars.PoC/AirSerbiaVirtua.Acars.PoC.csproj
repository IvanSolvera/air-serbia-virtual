<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AirSerbiaVirtua.Acars.PoC</RootNamespace>
    <AssemblyName>AirSerbiaVirtua.Acars.PoC</AssemblyName>
    <!-- Matches Core.x64 so the transitively-resolved FSUIPC bridge stays consistent. -->
