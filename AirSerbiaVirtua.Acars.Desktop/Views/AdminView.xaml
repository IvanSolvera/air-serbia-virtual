<UserControl x:Class="AirSerbiaVirtua.Acars.Desktop.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:AirSerbiaVirtua.Acars.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AdminViewModel}"
             d:DesignHeight="700" d:DesignWidth="980">

    <Grid Margin="36,30,36,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- phead -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Roster Admin" Style="{StaticResource Suite.PageTitle}" />
                <TextBlock Text="{Binding RosterSummary}" FontFamily="{StaticResource Suite.Mono}" FontSize="12"
                           Foreground="{StaticResource Suite.MistDim}" Margin="0,9,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource Suite.BtnCrimson}"
                    Command="{Binding RefreshCommand}" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Refresh" Width="15" Height="15" VerticalAlignment="Center" />
                    <TextBlock Text="Refresh" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" Foreground="{StaticResource Suite.RoyalBright}"
                     Background="Transparent" BorderThickness="0" Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}" />

        <!-- Status banner -->
        <Border Grid.Row="2" Margin="0,0,0,14"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Suite.Banner}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Background" Value="#26D8203F" />
                            <Setter Property="BorderBrush" Value="{StaticResource Suite.Crimson}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource Suite.Green}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource Suite.CrimsonBright}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusMessage}" FontSize="13"
                           Foreground="{StaticResource Suite.Mist}" TextWrapping="Wrap"
                           Margin="14,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Roster table -->
        <Border Grid.Row="3" Style="{StaticResource Suite.TblWrap}" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#8C061228" BorderBrush="{StaticResource Suite.Hairline}"
                        BorderThickness="0,0,0,1" CornerRadius="14,14,0,0" Padding="16,13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="95" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CALLSIGN" Style="{StaticResource Suite.ColHeader}" />
                        <TextBlock Grid.Column="1" Text="NAME" Style="{StaticResource Suite.ColHeader}" />
                        <TextBlock Grid.Column="2" Text="EMAIL" Style="{StaticResource Suite.ColHeader}" />
                        <TextBlock Grid.Column="3" Text="RANK" Style="{StaticResource Suite.ColHeader}" />
                        <TextBlock Grid.Column="4" Text="HOURS" Style="{StaticResource Suite.ColHeader}" />
                        <TextBlock Grid.Column="5" Text="JOINED" Style="{StaticResource Suite.ColHeader}" />
                        <TextBlock Grid.Column="6" Text="STATUS" Style="{StaticResource Suite.ColHeader}" />
                        <TextBlock Grid.Column="7" Text="" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Pilots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Suite.TblRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="95" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="105" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Callsign}" Style="{StaticResource Suite.FlightNo}" />
                                            <iconPacks:PackIconMaterial Kind="ShieldStarOutline" Width="12" Height="12"
                                                                        Foreground="{StaticResource Suite.RoyalBright}"
                                                                        Margin="6,0,0,0" VerticalAlignment="Center"
                                                                        ToolTip="Administrator"
                                                                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Suite.Cell}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Email}" Style="{StaticResource Suite.MutedCell}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding RankName}" Style="{StaticResource Suite.MutedCell}" />
                                        <TextBlock Grid.Column="4" Text="{Binding HoursLabel}" Style="{StaticResource Suite.Num}" />
                                        <TextBlock Grid.Column="5" Text="{Binding JoinedLabel}" Style="{StaticResource Suite.Num}" />

                                        <Border Grid.Column="6">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Suite.BadgeMist}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Pending">
                                                            <Setter Property="Background" Value="#24F5B545" />
                                                            <Setter Property="BorderBrush" Value="#5CF5B545" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Active">
                                                            <Setter Property="Background" Value="#2434D399" />
                                                            <Setter Property="BorderBrush" Value="#5C34D399" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Banned">
                                                            <Setter Property="Background" Value="#29D8203F" />
                                                            <Setter Property="BorderBrush" Value="#66D8203F" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusLabel}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Suite.BadgeText}">
                                                        <Setter Property="Foreground" Value="{StaticResource Suite.Mist}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusLabel}" Value="Pending">
                                                                <Setter Property="Foreground" Value="#FFFFE2B0" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusLabel}" Value="Active">
                                                                <Setter Property="Foreground" Value="#FFBDF3DD" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusLabel}" Value="Banned">
                                                                <Setter Property="Foreground" Value="#FFFFD2DA" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource Suite.BtnCrimson}"
                                                    Height="30" FontSize="11.5" Padding="12,0"
                                                    Content="Approve" Margin="0,0,8,0"
                                                    Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanActivate, Converter={StaticResource BoolToVisConverter}}" />
                                            <Button Style="{StaticResource Suite.BtnGhost}"
                                                    Height="30" FontSize="11.5" Padding="12,0"
                                                    Content="Deactivate"
                                                    Command="{Binding DataContext.DeactivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanDeactivate, Converter={StaticResource BoolToVisConverter}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
