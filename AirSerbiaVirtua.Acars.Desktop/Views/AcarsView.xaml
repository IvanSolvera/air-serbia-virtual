<UserControl x:Class="AirSerbiaVirtua.Acars.Desktop.Views.AcarsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:AirSerbiaVirtua.Acars.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AcarsViewModel}"
             d:DesignHeight="640" d:DesignWidth="960"
             Background="White">

    <UserControl.Resources>
        <!-- Telemetry tile -->
        <Style x:Key="TileBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brand.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="18,14" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============== Header ============== -->
        <Border Grid.Row="0" Padding="36,28,36,20" BorderBrush="{StaticResource Brand.Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ACARS Live" Style="{StaticResource H1}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="FLIGHT" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FlightNumber}" FontFamily="{StaticResource Brand.Sans}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brand.Dark}" Margin="6,0,18,0" VerticalAlignment="Center" />
                            <TextBlock Text="REG" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TailNumber}" FontFamily="{StaticResource Brand.Sans}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brand.Dark}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource RedButton}"
                            Content="Submit PIREP"
                            Command="{Binding SubmitPirepCommand}"
                            VerticalAlignment="Center"
                            MinWidth="150" Margin="0,0,12,0"
                            Visibility="{Binding HasActiveSession, Converter={StaticResource BoolToVisConverter}}" />

                    <Button Grid.Column="2"
                            Style="{StaticResource RedButton}"
                            Content="{Binding ConnectionButtonText}"
                            Command="{Binding ToggleConnectionCommand}"
                            VerticalAlignment="Center"
                            MinWidth="170" />
                </Grid>

                <!-- Session strip -->
                <Border Margin="0,18,0,0"
                        Padding="14,10"
                        BorderThickness="0,0,0,2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Brand.Surface}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brand.Border}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasActiveSession}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brand.Red}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding SessionHeaderText}" FontSize="12.5" Foreground="{StaticResource Brand.Dark}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="LAST POSREP" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LastPosRepText}" FontFamily="{StaticResource Brand.Sans}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brand.Dark}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding QueueStatusText}" FontFamily="{StaticResource Brand.Sans}" FontSize="11" Foreground="{StaticResource Brand.Dark}" Opacity="0.7" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding SubmitErrorMessage}"
                           FontSize="12"
                           Foreground="{StaticResource Brand.Red}"
                           Margin="0,10,0,0"
                           Visibility="{Binding SubmitErrorMessage, Converter={StaticResource NullToCollapsedConverter}}" />
            </StackPanel>
        </Border>

        <!-- ============== Main area ============== -->
        <Grid Grid.Row="1" Margin="36,24,36,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- =========== Left: phase + milestones + metrics =========== -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="FLIGHT PHASE" Style="{StaticResource Label}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Phases}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource Brand.Border}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Brand.Red}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="14,0,0,0" FontSize="13" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Brand.Muted}" />
                                            <Setter Property="FontWeight" Value="Regular" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Brand.Dark}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="MILESTONES" Style="{StaticResource Label}" Margin="0,28,0,10" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Off block"  Style="{StaticResource Body}" Margin="0,3" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OffBlockText}" FontFamily="{StaticResource Brand.Sans}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brand.Dark}" Margin="0,3" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Takeoff"   Style="{StaticResource Body}" Margin="0,3" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TakeoffText}" FontFamily="{StaticResource Brand.Sans}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brand.Dark}" Margin="0,3" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Landing"   Style="{StaticResource Body}" Margin="0,3" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LandingText}" FontFamily="{StaticResource Brand.Sans}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brand.Dark}" Margin="0,3" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="On block"  Style="{StaticResource Body}" Margin="0,3" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OnBlockText}" FontFamily="{StaticResource Brand.Sans}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brand.Dark}" Margin="0,3" />
                </Grid>

                <TextBlock Text="METRICS" Style="{StaticResource Label}" Margin="0,28,0,10" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Block time" Style="{StaticResource Body}" Margin="0,3" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BlockTimeText}" FontFamily="{StaticResource Brand.Sans}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brand.Dark}" Margin="0,3" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Air time"   Style="{StaticResource Body}" Margin="0,3" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AirTimeText}" FontFamily="{StaticResource Brand.Sans}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brand.Dark}" Margin="0,3" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Fuel used"  Style="{StaticResource Body}" Margin="0,3" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FuelUsedText}" FontFamily="{StaticResource Brand.Sans}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brand.Dark}" Margin="0,3" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Landing rate" Style="{StaticResource Body}" Margin="0,3" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LandingRateText}" FontFamily="{StaticResource Brand.Sans}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brand.Red}" Margin="0,3" />
                </Grid>
            </StackPanel>

            <!-- =========== Right: telemetry tiles =========== -->
            <Grid Grid.Column="1" Margin="36,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="TELEMETRY" Style="{StaticResource Label}" Margin="0,0,0,14" />

                <!-- Row 1 -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource TileBorder}" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="POSITION" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding LatText}" FontFamily="{StaticResource Brand.Sans}" FontSize="20" FontWeight="Light" Foreground="{StaticResource Brand.Dark}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding LonText}" FontFamily="{StaticResource Brand.Sans}" FontSize="20" FontWeight="Light" Foreground="{StaticResource Brand.Dark}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource TileBorder}" Margin="8,0,8,8">
                    <StackPanel>
                        <TextBlock Text="ALTITUDE" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding AltitudeText}" FontFamily="{StaticResource Brand.Sans}" FontSize="26" FontWeight="Light" Foreground="{StaticResource Brand.Dark}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource TileBorder}" Margin="8,0,0,8">
                    <StackPanel>
                        <TextBlock Text="FUEL" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding FuelText}" FontFamily="{StaticResource Brand.Sans}" FontSize="26" FontWeight="Light" Foreground="{StaticResource Brand.Dark}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Row 2 -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource TileBorder}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="IAS" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding IasText}" FontFamily="{StaticResource Brand.Sans}" FontSize="26" FontWeight="Light" Foreground="{StaticResource Brand.Dark}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource TileBorder}" Margin="8,0,8,0">
                    <StackPanel>
                        <TextBlock Text="GROUND SPEED" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding GsText}" FontFamily="{StaticResource Brand.Sans}" FontSize="26" FontWeight="Light" Foreground="{StaticResource Brand.Dark}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource TileBorder}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="VERTICAL SPEED" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding VsText}" FontFamily="{StaticResource Brand.Sans}" FontSize="26" FontWeight="Light" Foreground="{StaticResource Brand.Dark}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Row 3: aircraft state strip -->
                <Border Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource TileBorder}" Margin="0,16,0,0" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Airplane" Width="18" Height="18" Foreground="{StaticResource Brand.Red}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding GroundStateText}" FontFamily="{StaticResource Brand.Sans}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Brand.Dark}" Margin="10,0,28,0" VerticalAlignment="Center" />
                        <iconPacks:PackIconMaterial Kind="CarBrakeParking" Width="18" Height="18" Foreground="{StaticResource Brand.Muted}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BrakeStateText}" FontFamily="{StaticResource Brand.Sans}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Brand.Dark}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
