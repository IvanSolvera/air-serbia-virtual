<UserControl x:Class="AirSerbiaVirtua.Acars.Desktop.Views.BookingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:AirSerbiaVirtua.Acars.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BookingsViewModel}"
             d:DesignHeight="700" d:DesignWidth="960">

    <Grid Margin="36,30,36,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- phead -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Bookings" Style="{StaticResource Suite.PageTitle}" />
                <TextBlock Text="Reserve a route from the schedule, then take it flying."
                           Style="{StaticResource Suite.PageSub}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource Suite.BtnCrimson}"
                    Command="{Binding RefreshCommand}" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Refresh" Width="15" Height="15" VerticalAlignment="Center" />
                    <TextBlock Text="Refresh" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Status banner -->
        <Border Grid.Row="1" Margin="0,0,0,16"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Suite.Banner}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Background" Value="#26D8203F" />
                            <Setter Property="BorderBrush" Value="{StaticResource Suite.Crimson}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource Suite.Amber}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource Suite.CrimsonBright}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#FFF5B545" BlurRadius="9" ShadowDepth="0" Opacity="0.8" />
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock Text="{Binding StatusMessage}" FontSize="13"
                           Foreground="{StaticResource Suite.Mist}" TextWrapping="Wrap"
                           Margin="14,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- =========== Available routes =========== -->
        <TextBlock Grid.Row="2" Text="AVAILABLE ROUTES" Style="{StaticResource Suite.MonoLabel}" Margin="0,0,0,12" />

        <Border Grid.Row="3" Style="{StaticResource Suite.TblWrap}" Margin="0,0,0,30" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#8C061228" BorderBrush="{StaticResource Suite.Hairline}"
                        BorderThickness="0,0,0,1" CornerRadius="14,14,0,0" Padding="16,13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="95" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="FLIGHT" Style="{StaticResource Suite.ColHeader}" />
                        <TextBlock Grid.Column="1" Text="LEG" Style="{StaticResource Suite.ColHeader}" />
                        <TextBlock Grid.Column="2" Text="A/C" Style="{StaticResource Suite.ColHeader}" />
                        <TextBlock Grid.Column="3" Text="DISTANCE" Style="{StaticResource Suite.ColHeader}" />
                        <TextBlock Grid.Column="4" Text="ETE" Style="{StaticResource Suite.ColHeader}" />
                        <TextBlock Grid.Column="5" Text="" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Routes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Suite.TblRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="95" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding FlightNumber}" Style="{StaticResource Suite.FlightNo}" />
                                        <TextBlock Grid.Column="1" Text="{Binding LegLabel}" Style="{StaticResource Suite.Leg}" />
                                        <Border Grid.Column="2" Style="{StaticResource Suite.Chip}">
                                            <TextBlock Text="{Binding AircraftType}" Style="{StaticResource Suite.ChipText}" />
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{Binding DistanceNm, StringFormat='{}{0} nm'}" Style="{StaticResource Suite.Num}" />
                                        <TextBlock Grid.Column="4" Text="{Binding PlannedTimeLabel}" Style="{StaticResource Suite.Num}" />
                                        <Button Grid.Column="5"
                                                Style="{StaticResource Suite.BtnCrimson}"
                                                Height="32" FontSize="12" Padding="12,0"
                                                Content="Book today"
                                                HorizontalAlignment="Right"
                                                Command="{Binding DataContext.BookRouteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- =========== My bookings =========== -->
        <TextBlock Grid.Row="4" Text="MY BOOKINGS" Style="{StaticResource Suite.MonoLabel}" Margin="0,0,0,12" />

        <Border Grid.Row="5" Style="{StaticResource Suite.TblWrap}" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#8C061228" BorderBrush="{StaticResource Suite.Hairline}"
                        BorderThickness="0,0,0,1" CornerRadius="14,14,0,0" Padding="16,13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="FLIGHT" Style="{StaticResource Suite.ColHeader}" />
                        <TextBlock Grid.Column="1" Text="LEG" Style="{StaticResource Suite.ColHeader}" />
                        <TextBlock Grid.Column="2" Text="A/C" Style="{StaticResource Suite.ColHeader}" />
                        <TextBlock Grid.Column="3" Text="DATE" Style="{StaticResource Suite.ColHeader}" />
                        <TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource Suite.ColHeader}" />
                        <TextBlock Grid.Column="5" Text="" />
                        <TextBlock Grid.Column="6" Text="" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MyBookings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Suite.TblRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding FlightNumber}" Style="{StaticResource Suite.FlightNo}" />
                                            <TextBlock Grid.Column="1" Text="{Binding LegLabel}" Style="{StaticResource Suite.Leg}" />
                                            <Border Grid.Column="2" Style="{StaticResource Suite.Chip}">
                                                <TextBlock Text="{Binding AircraftType}" Style="{StaticResource Suite.ChipText}" />
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding Date, StringFormat='yyyy-MM-dd'}" Style="{StaticResource Suite.Num}" />
                                            <Border Grid.Column="4" Style="{StaticResource Suite.BadgeGreen}">
                                                <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource Suite.BadgeText}"
                                                           Foreground="#FFBDF3DD" />
                                            </Border>
                                            <Button Grid.Column="5"
                                                    Style="{StaticResource Suite.BtnCrimson}"
                                                    Height="32" FontSize="12" Padding="12,0"
                                                    Content="Start flight"
                                                    Margin="0,0,8,0"
                                                    Command="{Binding DataContext.StartFlightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Grid.Column="6"
                                                    Style="{StaticResource Suite.BtnGhost}"
                                                    Height="32" FontSize="12" Padding="12,0"
                                                    Content="Cancel"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding DataContext.CancelBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty state -->
                    <TextBlock Text="No active bookings. Reserve a route above to get started."
                               Foreground="{StaticResource Suite.MistDim}" FontSize="13"
                               HorizontalAlignment="Center" Margin="16,42"
                               Visibility="{Binding MyBookings.Count, Converter={StaticResource ZeroToVisConverter}}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
