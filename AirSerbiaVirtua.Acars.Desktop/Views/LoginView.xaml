<UserControl x:Class="AirSerbiaVirtua.Acars.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:AirSerbiaVirtua.Acars.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:LoginViewModel}"
             d:DesignHeight="540" d:DesignWidth="700">

    <Grid Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
        <Border MaxWidth="420"
                Padding="32,28"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="{DynamicResource MahApps.Brushes.Window.Background}"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <iconPacks:PackIconMaterial Kind="Airplane"
                                                Width="28" Height="28"
                                                Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                                VerticalAlignment="Center" />
                    <TextBlock Text="Air Serbia Virtua"
                               FontSize="22" FontWeight="Light"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="Pilot login"
                           Style="{DynamicResource MahApps.Styles.TextBlock.Subheadline}"
                           Margin="0,0,0,16" />

                <TextBlock Text="Callsign" Margin="0,0,0,4" />
                <TextBox Text="{Binding Callsign, UpdateSourceTrigger=PropertyChanged}"
                         mah:TextBoxHelper.Watermark="e.g. ASL001"
                         IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                         Margin="0,0,0,14" />

                <TextBlock Text="Password" Margin="0,0,0,4" />
                <PasswordBox x:Name="PasswordBox"
                             PasswordChanged="PasswordBox_OnPasswordChanged"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                             Margin="0,0,0,18" />

                <Button Content="Sign in"
                        Command="{Binding LoginCommand}"
                        Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                        Height="38" />

                <ProgressBar IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"
                             Height="3"
                             Margin="0,12,0,0" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#C0392B"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedConverter}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
