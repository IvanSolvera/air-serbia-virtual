<UserControl x:Class="AirSerbiaVirtua.Acars.Desktop.Views.LogbookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:AirSerbiaVirtua.Acars.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:LogbookViewModel}"
             d:DesignHeight="700" d:DesignWidth="980"
             Background="White">

    <UserControl.Resources>
        <Style x:Key="ColHeader" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Brand.Sans}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Brand.Dark}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Logbook" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding TotalsText}" Style="{StaticResource Body}" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                          Width="150" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource RedButton}" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" Foreground="{StaticResource Brand.Red}"
                     Background="Transparent" BorderThickness="0" Margin="0,16,0,0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}" />

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Style="{StaticResource Body}" Margin="0,16,0,0"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}" />

        <!-- Table -->
        <Border Grid.Row="3" Margin="0,18,0,0" BorderBrush="{StaticResource Brand.Border}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column headers -->
                <Border Grid.Row="0" Background="{StaticResource Brand.Surface}" BorderBrush="{StaticResource Brand.Border}" BorderThickness="0,0,0,1" Padding="18,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="FLIGHT" Style="{StaticResource ColHeader}" />
                        <TextBlock Grid.Column="1" Text="ROUTE" Style="{StaticResource ColHeader}" />
                        <TextBlock Grid.Column="2" Text="AIRCRAFT" Style="{StaticResource ColHeader}" />
                        <TextBlock Grid.Column="3" Text="DATE" Style="{StaticResource ColHeader}" />
                        <TextBlock Grid.Column="4" Text="BLOCK" Style="{StaticResource ColHeader}" />
                        <TextBlock Grid.Column="5" Text="AIR" Style="{StaticResource ColHeader}" />
                        <TextBlock Grid.Column="6" Text="LANDING" Style="{StaticResource ColHeader}" />
                        <TextBlock Grid.Column="7" Text="SCORE" Style="{StaticResource ColHeader}" />
                        <TextBlock Grid.Column="8" Text="STATUS" Style="{StaticResource ColHeader}" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Pireps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brand.Border}" BorderThickness="0,0,0,1" Padding="18,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding FlightNumber}" Style="{StaticResource Cell}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding LegLabel}" Style="{StaticResource Cell}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Registration}" Style="{StaticResource Cell}" />
                                        <TextBlock Grid.Column="3" Text="{Binding DateLabel}" Style="{StaticResource Cell}" />
                                        <TextBlock Grid.Column="4" Text="{Binding BlockLabel}" Style="{StaticResource Cell}" />
                                        <TextBlock Grid.Column="5" Text="{Binding AirLabel}" Style="{StaticResource Cell}" />
                                        <TextBlock Grid.Column="6" Text="{Binding LandingLabel}" Style="{StaticResource Cell}" />
                                        <TextBlock Grid.Column="7" Text="{Binding Score}" Style="{StaticResource Cell}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="8" Text="{Binding StatusLabel}" Style="{StaticResource Cell}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
