<UserControl x:Class="AirSerbiaVirtua.Acars.Desktop.Views.LogbookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:AirSerbiaVirtua.Acars.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:LogbookViewModel}"
             d:DesignHeight="700" d:DesignWidth="980">

    <Grid Margin="36,30,36,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- phead -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Logbook" Style="{StaticResource Suite.PageTitle}" />
                <TextBlock Text="{Binding TotalsText}" FontFamily="{StaticResource Suite.Mono}" FontSize="12"
                           Foreground="{StaticResource Suite.MistDim}" Margin="0,9,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                          Style="{StaticResource Suite.Combo}" Width="150" Margin="0,0,10,0" />
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource Suite.BtnCrimson}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" Foreground="{StaticResource Suite.RoyalBright}"
                     Background="Transparent" BorderThickness="0" Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}" />

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Style="{StaticResource Suite.Body}" Margin="0,0,0,12"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}" />

        <!-- Table -->
        <Border Grid.Row="3" Style="{StaticResource Suite.TblWrap}" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#8C061228" BorderBrush="{StaticResource Suite.Hairline}"
                        BorderThickness="0,0,0,1" CornerRadius="14,14,0,0" Padding="16,13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="115" />
                            <ColumnDefinition Width="85" />
                            <ColumnDefinition Width="85" />
                            <ColumnDefinition Width="85" />
                            <ColumnDefinition Width="65" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="FLIGHT" Style="{StaticResource Suite.ColHeader}" />
                        <TextBlock Grid.Column="1" Text="ROUTE" Style="{StaticResource Suite.ColHeader}" />
                        <TextBlock Grid.Column="2" Text="AIRCRAFT" Style="{StaticResource Suite.ColHeader}" />
                        <TextBlock Grid.Column="3" Text="DATE" Style="{StaticResource Suite.ColHeader}" />
                        <TextBlock Grid.Column="4" Text="BLOCK" Style="{StaticResource Suite.ColHeader}" />
                        <TextBlock Grid.Column="5" Text="AIR" Style="{StaticResource Suite.ColHeader}" />
                        <TextBlock Grid.Column="6" Text="LANDING" Style="{StaticResource Suite.ColHeader}" />
                        <TextBlock Grid.Column="7" Text="SCORE" Style="{StaticResource Suite.ColHeader}" />
                        <TextBlock Grid.Column="8" Text="STATUS" Style="{StaticResource Suite.ColHeader}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Pireps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Suite.TblRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="115" />
                                                <ColumnDefinition Width="85" />
                                                <ColumnDefinition Width="85" />
                                                <ColumnDefinition Width="85" />
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding FlightNumber}" Style="{StaticResource Suite.FlightNo}" />
                                            <TextBlock Grid.Column="1" Text="{Binding LegLabel}" Style="{StaticResource Suite.Leg}" />
                                            <Border Grid.Column="2" Style="{StaticResource Suite.Chip}">
                                                <TextBlock Text="{Binding Registration}" Style="{StaticResource Suite.ChipText}" />
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding DateLabel}" Style="{StaticResource Suite.Num}" />
                                            <TextBlock Grid.Column="4" Text="{Binding BlockLabel}" Style="{StaticResource Suite.Num}" />
                                            <TextBlock Grid.Column="5" Text="{Binding AirLabel}" Style="{StaticResource Suite.Num}" />
                                            <TextBlock Grid.Column="6" Text="{Binding LandingLabel}" Style="{StaticResource Suite.Num}" />
                                            <TextBlock Grid.Column="7" Text="{Binding Score}" Style="{StaticResource Suite.Num}"
                                                       Foreground="{StaticResource Suite.Cloud}" FontWeight="SemiBold" />
                                            <Border Grid.Column="8">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Suite.BadgeAmber}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusLabel}" Value="Accepted">
                                                                <Setter Property="Background" Value="#2434D399" />
                                                                <Setter Property="BorderBrush" Value="#5C34D399" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusLabel}" Value="Rejected">
                                                                <Setter Property="Background" Value="#29D8203F" />
                                                                <Setter Property="BorderBrush" Value="#66D8203F" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusLabel}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Suite.BadgeText}">
                                                            <Setter Property="Foreground" Value="#FFFFE2B0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="Accepted">
                                                                    <Setter Property="Foreground" Value="#FFBDF3DD" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="Rejected">
                                                                    <Setter Property="Foreground" Value="#FFFFD2DA" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty state -->
                    <TextBlock Text="No flights logged yet. Your submitted PIREPs will appear here."
                               Foreground="{StaticResource Suite.MistDim}" FontSize="13"
                               HorizontalAlignment="Center" Margin="16,42"
                               Visibility="{Binding Pireps.Count, Converter={StaticResource ZeroToVisConverter}}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
