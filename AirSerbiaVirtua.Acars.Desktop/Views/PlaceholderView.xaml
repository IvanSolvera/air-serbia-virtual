<UserControl x:Class="AirSerbiaVirtua.Acars.Desktop.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:AirSerbiaVirtua.Acars.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PlaceholderViewModel}"
             d:DesignHeight="540" d:DesignWidth="900">

    <Grid Margin="36,30,36,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- phead -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Suite.PageTitle}" />
        </StackPanel>

        <!-- .empty -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="540">

            <Border Width="84" Height="84" CornerRadius="42"
                    BorderBrush="{StaticResource Suite.HairlineStrong}" BorderThickness="1"
                    HorizontalAlignment="Center" Margin="0,0,0,24">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.35" GradientOrigin="0.5,0.35" RadiusX="0.8" RadiusY="0.8">
                        <GradientStop Color="#2E2563D6" Offset="0" />
                        <GradientStop Color="#66081628" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
                <iconPacks:PackIconMaterial Kind="WrenchClockOutline"
                                            Width="34" Height="34"
                                            Foreground="{StaticResource Suite.RoyalBright}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="{Binding Title}"
                       FontFamily="{StaticResource Suite.Display}" FontWeight="ExtraBold" FontSize="26"
                       Foreground="{StaticResource Suite.Cloud}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Description}"
                       Style="{StaticResource Suite.Body}"
                       FontSize="13.5"
                       LineHeight="22" LineStackingStrategy="BlockLineHeight"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="440"
                       Margin="0,12,0,0" />

            <Border Style="{StaticResource Suite.BadgeMist}" HorizontalAlignment="Center" Margin="0,18,0,0">
                <TextBlock Text="PHASE 5 · PLANNED" Style="{StaticResource Suite.BadgeText}"
                           Foreground="{StaticResource Suite.Mist}" />
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
