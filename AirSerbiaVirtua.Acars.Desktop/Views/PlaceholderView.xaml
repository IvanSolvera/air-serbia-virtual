<UserControl x:Class="AirSerbiaVirtua.Acars.Desktop.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:AirSerbiaVirtua.Acars.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PlaceholderViewModel}"
             d:DesignHeight="540" d:DesignWidth="900">

    <Grid Background="White">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="540" Margin="48">

            <Border Width="64" Height="64"
                    Background="{StaticResource Brand.Surface}"
                    BorderBrush="{StaticResource Brand.Border}"
                    BorderThickness="1"
                    CornerRadius="32"
                    HorizontalAlignment="Center">
                <iconPacks:PackIconMaterial Kind="ToolboxOutline"
                                            Width="28" Height="28"
                                            Foreground="{StaticResource Brand.Red}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource H1}"
                       HorizontalAlignment="Center"
                       Margin="0,22,0,12" />
            <TextBlock Text="{Binding Description}"
                       Style="{StaticResource Body}"
                       FontSize="14"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
