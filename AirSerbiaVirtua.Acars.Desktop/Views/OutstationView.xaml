<UserControl x:Class="AirSerbiaVirtua.Acars.Desktop.Views.OutstationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:AirSerbiaVirtua.Acars.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:OutstationViewModel}"
             d:DesignHeight="700" d:DesignWidth="980">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,36">

            <!-- phead -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Outstation Flights" Style="{StaticResource Suite.PageTitle}" />
                    <TextBlock Text="Ad-hoc charter legs outside the scheduled network — fly anywhere, ACARS tracks it like any other flight."
                               Style="{StaticResource Suite.PageSub}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Suite.BtnGhost}"
                        Command="{Binding RefreshCommand}" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh fleet" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Status banner -->
            <Border Margin="0,0,0,16"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Suite.Banner}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Background" Value="#26D8203F" />
                                <Setter Property="BorderBrush" Value="{StaticResource Suite.Crimson}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Suite.Green}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Suite.CrimsonBright}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13"
                               Foreground="{StaticResource Suite.Mist}" TextWrapping="Wrap"
                               Margin="14,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Charter form -->
            <TextBlock Text="CHARTER DETAILS" Style="{StaticResource Suite.MonoLabel}" Margin="0,0,0,12" />
            <Border Style="{StaticResource Suite.Panel}" MaxWidth="560" HorizontalAlignment="Left">
                <StackPanel>
                    <!-- Flight number -->
                    <TextBlock Text="FLIGHT NUMBER" FontSize="10.5" FontWeight="Bold"
                               Foreground="{StaticResource Suite.Mist}" Margin="0,0,0,8" />
                    <TextBox Style="{StaticResource Suite.Input}" Height="44" Padding="14,0" Width="180"
                             HorizontalAlignment="Left"
                             Text="{Binding FlightNumber, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                             CharacterCasing="Upper" MaxLength="10" Margin="0,0,0,16" />

                    <!-- Dep / Arr -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DEPARTURE ICAO" FontSize="10.5" FontWeight="Bold"
                                       Foreground="{StaticResource Suite.Mist}" Margin="0,0,0,8" />
                            <TextBox Style="{StaticResource Suite.Input}" Height="44" Padding="14,0"
                                     Text="{Binding DepIcao, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                                     CharacterCasing="Upper" MaxLength="4" />
                        </StackPanel>
                        <iconPacks:PackIconMaterial Grid.Column="1" Kind="ArrowRight" Width="18" Height="18"
                                                    Foreground="{StaticResource Suite.MistDim}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                    Margin="0,0,0,13" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ARRIVAL ICAO" FontSize="10.5" FontWeight="Bold"
                                       Foreground="{StaticResource Suite.Mist}" Margin="0,0,0,8" />
                            <TextBox Style="{StaticResource Suite.Input}" Height="44" Padding="14,0"
                                     Text="{Binding ArrIcao, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                                     CharacterCasing="Upper" MaxLength="4" />
                        </StackPanel>
                    </Grid>

                    <!-- Aircraft -->
                    <TextBlock Text="AIRCRAFT" FontSize="10.5" FontWeight="Bold"
                               Foreground="{StaticResource Suite.Mist}" Margin="0,0,0,8" />
                    <ComboBox Style="{StaticResource Suite.Combo}" Height="44"
                              ItemsSource="{Binding Fleet}"
                              SelectedItem="{Binding SelectedAircraft}"
                              IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                              Margin="0,0,0,20">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Registration}" FontFamily="{StaticResource Suite.Mono}"
                                               FontWeight="SemiBold" Foreground="{StaticResource Suite.Cloud}" />
                                    <TextBlock Text="{Binding Type}" FontFamily="{StaticResource Suite.Mono}"
                                               Foreground="{StaticResource Suite.MistDim}" Margin="10,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Style="{StaticResource Suite.BtnCrimson}" Command="{Binding StartFlightCommand}"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="AirplaneTakeoff" Width="15" Height="15"
                                                        VerticalAlignment="Center" />
                            <TextBlock Text="Start outstation flight" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <ProgressBar IsIndeterminate="True" Height="2" Foreground="{StaticResource Suite.RoyalBright}"
                                 Background="Transparent" BorderThickness="0" Margin="0,12,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}" />
                </StackPanel>
            </Border>

            <!-- How it works -->
            <Border Style="{StaticResource Suite.Banner}" Margin="0,18,0,0" MaxWidth="560" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="InformationOutline" Width="15" Height="15"
                                                Foreground="{StaticResource Suite.RoyalBright}" VerticalAlignment="Top"
                                                Margin="0,2,0,0" />
                    <TextBlock FontSize="12.5" Foreground="{StaticResource Suite.Mist}" TextWrapping="Wrap"
                               LineHeight="19" LineStackingStrategy="BlockLineHeight" Margin="12,0,0,0" MaxWidth="480">
                        Outstation legs skip the booking system: starting one opens an ACARS session
                        immediately. Unknown airports are registered automatically; the leg shows up in
                        your Logbook like any scheduled flight, and counts toward your hours when accepted.
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
