<UserControl x:Class="AirSerbiaVirtua.Acars.Desktop.Views.PilotCentreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:AirSerbiaVirtua.Acars.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PilotCentreViewModel}"
             d:DesignHeight="700" d:DesignWidth="960"
             Background="White">

    <UserControl.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Brand.Sans}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brand.Dark}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,36" MaxWidth="900" HorizontalAlignment="Left">

            <TextBlock Text="Pilot Centre" Style="{StaticResource H1}" />
            <TextBlock Text="Your roster profile, rank progression and account settings."
                       Style="{StaticResource Body}" Margin="0,6,0,28" />

            <!-- Profile card -->
            <Border Background="White" BorderBrush="{StaticResource Brand.Border}" BorderThickness="1" CornerRadius="6" Padding="28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Avatar -->
                    <Border Grid.Column="0" Width="84" Height="84" CornerRadius="42"
                            Background="{StaticResource Brand.Dark}" VerticalAlignment="Top" Margin="0,0,28,0">
                        <TextBlock Text="{Binding Initials}" Foreground="White"
                                   FontFamily="{StaticResource Brand.Serif}" FontSize="30"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                            <Border Background="{StaticResource Brand.Surface}" BorderBrush="{StaticResource Brand.Border}" BorderThickness="1"
                                    CornerRadius="3" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Callsign}" FontFamily="{StaticResource Brand.Sans}" FontSize="12.5"
                                           FontWeight="SemiBold" Foreground="{StaticResource Brand.Red}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Email}" Style="{StaticResource Body}" Margin="0,4,0,20" />

                        <UniformGrid Columns="4" >
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="RANK" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding RankName}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="TOTAL HOURS" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding TotalHours}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="HUB" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding Hub}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="STATUS" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                        </UniformGrid>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <iconPacks:PackIconMaterial Kind="CalendarAccount" Width="14" Height="14"
                                                        Foreground="{StaticResource Brand.Muted}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Body}" Margin="8,0,0,0" VerticalAlignment="Center">
                                <Run Text="Joined" /><Run Text=" " /><Run Text="{Binding Joined, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Change password -->
            <TextBlock Text="Change password" Style="{StaticResource H2}" Margin="0,32,0,4" />
            <TextBlock Text="Changing your password signs you out on all other devices."
                       Style="{StaticResource Body}" Margin="0,0,0,16" />

            <Border Background="White" BorderBrush="{StaticResource Brand.Border}" BorderThickness="1" CornerRadius="6" Padding="24" MaxWidth="460" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="CURRENT PASSWORD" Style="{StaticResource Label}" Margin="0,0,0,6" />
                    <PasswordBox x:Name="CurrentPasswordBox" Style="{StaticResource BrandPasswordBox}"
                                 PasswordChanged="CurrentPasswordBox_OnPasswordChanged" Margin="0,0,0,16" />

                    <TextBlock Text="NEW PASSWORD" Style="{StaticResource Label}" Margin="0,0,0,6" />
                    <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource BrandPasswordBox}"
                                 PasswordChanged="NewPasswordBox_OnPasswordChanged" Margin="0,0,0,16" />

                    <TextBlock Text="CONFIRM NEW PASSWORD" Style="{StaticResource Label}" Margin="0,0,0,6" />
                    <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource BrandPasswordBox}"
                                 PasswordChanged="ConfirmPasswordBox_OnPasswordChanged" Margin="0,0,0,20" />

                    <Button Content="UPDATE PASSWORD" Command="{Binding ChangePasswordCommand}"
                            Style="{StaticResource RedButton}" HorizontalAlignment="Left" />

                    <ProgressBar IsIndeterminate="True" Height="2" Foreground="{StaticResource Brand.Red}"
                                 Background="Transparent" BorderThickness="0" Margin="0,12,0,0"
                                 Visibility="{Binding IsChangingPassword, Converter={StaticResource BoolToVisConverter}}" />

                    <TextBlock Text="{Binding PasswordMessage}" TextWrapping="Wrap" FontSize="12.5" Margin="0,12,0,0"
                               Visibility="{Binding PasswordMessage, Converter={StaticResource NullToCollapsedConverter}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brand.Muted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PasswordError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brand.RedDark}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Signed-out hint -->
            <Border Visibility="{Binding IsSignedIn, Converter={StaticResource InvertBoolConverter}}"
                    Background="#FFF7E9EE" BorderBrush="{StaticResource Brand.Red}" BorderThickness="0,0,0,2"
                    Padding="14,12" Margin="0,18,0,0" HorizontalAlignment="Left">
                <TextBlock Text="Sign in to view your pilot profile." Foreground="{StaticResource Brand.RedDark}" FontSize="12.5" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
