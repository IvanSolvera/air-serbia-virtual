<mah:MetroWindow x:Class="AirSerbiaVirtua.Acars.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:vm="clr-namespace:AirSerbiaVirtua.Acars.Desktop.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:MainViewModel}"
                 Title="Air Serbia Virtua ACARS"
                 Height="720" Width="1180"
                 MinHeight="600" MinWidth="980"
                 WindowStartupLocation="CenterScreen"
                 TitleCharacterCasing="Normal"
                 ShowIconOnTitleBar="False"
                 WindowTitleBrush="{StaticResource Brand.Dark}"
                 NonActiveWindowTitleBrush="{StaticResource Brand.DarkSoft}"
                 Background="{StaticResource Brand.Surface}"
                 FontFamily="{StaticResource Brand.Sans}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============== Side navigation ============== -->
        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource Brand.Dark}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand block at top of sidebar -->
                <Border Grid.Row="0" Background="{StaticResource Brand.DarkSoft}" Padding="20,22">
                    <StackPanel>
                        <Image Source="pack://application:,,,/Resources/airserbia-logo.png"
                               Height="56" Width="56" HorizontalAlignment="Left" />
                        <TextBlock Text="VIRTUA"
                                   FontFamily="{StaticResource Brand.Serif}"
                                   FontSize="20"
                                   Foreground="White"
                                   Margin="0,12,0,0"
                                   LineHeight="20" />
                        <TextBlock Text="ACARS Operations"
                                   FontFamily="{StaticResource Brand.Sans}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource Brand.MutedOnDark}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Nav items -->
                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateLoginCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Login" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="Login" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigatePilotCentreCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="AccountTie" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="Pilot Centre" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateBookingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="BookmarkOutline" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="Bookings" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateAcarsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="RadioTower" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="ACARS Live" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateLogbookCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="NotebookOutline" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="Logbook" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Logout at bottom -->
                <Border Grid.Row="2" BorderBrush="{StaticResource Brand.DarkSoft}" BorderThickness="0,1,0,0">
                    <Button Style="{StaticResource NavButton}" Command="{Binding LogoutCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Logout" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="Sign out" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- ============== Active page ============== -->
        <ContentControl Grid.Row="0" Grid.Column="1"
                        Content="{Binding Navigation.CurrentView}" />

        <!-- ============== Status bar ============== -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{StaticResource Brand.Dark}"
                Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Brand.MutedOnDark}" VerticalAlignment="Center" />
                    <TextBlock Text="SIM" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Brand.MutedOnDark}" Margin="8,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SimStatusText}" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Brand.Red}" VerticalAlignment="Center" />
                    <TextBlock Text="SERVER" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Brand.MutedOnDark}" Margin="8,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ServerStatusText}" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="AccountCircle" Foreground="{StaticResource Brand.MutedOnDark}" Width="14" Height="14" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PilotStatusText}" FontSize="12" Foreground="White" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</mah:MetroWindow>
