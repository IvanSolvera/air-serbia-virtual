<mah:MetroWindow x:Class="AirSerbiaVirtua.Acars.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:vm="clr-namespace:AirSerbiaVirtua.Acars.Desktop.ViewModels"
                 Title="Air Serbia Virtua ACARS"
                 Height="640" Width="980"
                 MinHeight="520" MinWidth="800"
                 ShowIconOnTitleBar="True"
                 TitleCharacterCasing="Normal"
                 WindowStartupLocation="CenterScreen"
                 d:DataContext="{d:DesignInstance vm:MainViewModel}"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Side navigation -->
        <Border Grid.Row="0" Grid.Column="0"
                Background="{DynamicResource MahApps.Brushes.Accent4}"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="0,12,0,0">
                <StackPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button}">
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="Padding" Value="14,10" />
                        <Setter Property="Margin" Value="0,2,0,0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </StackPanel.Resources>

                <Button Command="{Binding NavigateLoginCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Login" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock Text="Login" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding NavigatePilotCentreCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="AccountTie" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock Text="Pilot Centre" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding NavigateBookingsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="BookmarkOutline" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock Text="Bookings" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding NavigateAcarsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="RadioTower" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock Text="ACARS" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding NavigateLogbookCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="NotebookOutline" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock Text="Logbook" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Separator Margin="14,12" />

                <Button Command="{Binding LogoutCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Logout" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock Text="Logout" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Active page -->
        <ContentControl Grid.Row="0" Grid.Column="1"
                        Content="{Binding Navigation.CurrentView}" />

        <!-- Status bar -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{DynamicResource MahApps.Brushes.Accent3}"
                Padding="14,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Sim: " Foreground="White" Opacity="0.7" />
                    <TextBlock Text="{Binding SimStatusText}" Foreground="White" FontWeight="SemiBold" Margin="4,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,18,0">
                    <TextBlock Text="Server: " Foreground="White" Opacity="0.7" />
                    <TextBlock Text="{Binding ServerStatusText}" Foreground="White" FontWeight="SemiBold" Margin="4,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="AccountCircle" Foreground="White" VerticalAlignment="Center" Width="14" Height="14" />
                    <TextBlock Text="{Binding PilotStatusText}" Foreground="White" FontWeight="SemiBold" Margin="6,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</mah:MetroWindow>
