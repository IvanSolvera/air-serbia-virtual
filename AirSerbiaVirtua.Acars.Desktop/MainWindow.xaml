<Window x:Class="AirSerbiaVirtua.Acars.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:vm="clr-namespace:AirSerbiaVirtua.Acars.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Air Serbia Virtual — ACARS"
        Width="1320" Height="840"
        MinWidth="1180" MinHeight="760"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource Suite.WindowBg}"
        FontFamily="{StaticResource Suite.Sans}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- ============================ TITLE BAR ============================ -->
        <Border Grid.Row="0" Background="{StaticResource Suite.TitlebarBg}"
                BorderBrush="{StaticResource Suite.Hairline}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Serbian-flag accent stripe -->
                <Rectangle Grid.Column="0" Width="4" Fill="{StaticResource Suite.FlagStripe}" />

                <!-- Brand -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,16,0"
                            VerticalAlignment="Center">
                    <!-- Chevron mark (from the suite logo) -->
                    <Border Width="26" Height="26" CornerRadius="6"
                            BorderBrush="#24FFFFFF" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF1B3E6E" Offset="0" />
                                <GradientStop Color="#FF08152E" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Viewbox Margin="2">
                            <Canvas Width="120" Height="120">
                                <Path Data="M27,58 L46,40 L60,51 L74,40 L93,58"
                                      Stroke="#FFF4F7FB" StrokeThickness="8.5"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Path Data="M22,77 L60,58 L98,77"
                                      Stroke="#FFF4F7FB" StrokeThickness="8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Path Data="M34,91 L60,77 L86,91"
                                      Stroke="#FFD8203F" StrokeThickness="7.5"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Air Serbia Virtual"
                                   FontFamily="{StaticResource Suite.Display}" FontWeight="ExtraBold"
                                   FontSize="13.5" Foreground="{StaticResource Suite.Cloud}" />
                        <TextBlock Text="F L I G H T   C R E W   S U I T E"
                                   FontFamily="{StaticResource Suite.Mono}" FontSize="8"
                                   Foreground="{StaticResource Suite.Mist}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Divider + module -->
                <Rectangle Grid.Column="2" Width="1" Height="22" Fill="{StaticResource Suite.Hairline}"
                           VerticalAlignment="Center" Margin="4,0" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource Suite.Crimson}">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#FFD8203F" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="ACARS  TERMINAL" FontFamily="{StaticResource Suite.Mono}" FontSize="11"
                               Foreground="{StaticResource Suite.Mist}" Margin="8,0,0,0" />
                </StackPanel>

                <!-- Meta -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock FontFamily="{StaticResource Suite.Mono}" FontSize="10.5"
                               Foreground="{StaticResource Suite.MistDim}">
                        <Run Text="{Binding VersionText, Mode=OneWay}" /><Run Text=" " /><Run
                            Text="ACARS DESKTOP" Foreground="{StaticResource Suite.Mist}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock FontFamily="{StaticResource Suite.Mono}" FontSize="10.5" Margin="18,0,0,0"
                               Foreground="{StaticResource Suite.MistDim}">
                        <Run Text="NET" /><Run Text=" " /><Run
                            Text="ASV" Foreground="{StaticResource Suite.Mist}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>

                <!-- Window controls -->
                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <Button Style="{StaticResource Suite.WinBtn}" Click="Minimize_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize">
                        <Path Data="M0,0 H10" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.6" VerticalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource Suite.WinBtn}" Click="Maximize_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize">
                        <Rectangle Width="10" Height="10" RadiusX="1.5" RadiusY="1.5"
                                   Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                   StrokeThickness="1.6" />
                    </Button>
                    <Button Style="{StaticResource Suite.WinBtnClose}" Click="Close_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close">
                        <Path Data="M0,0 L10,10 M10,0 L0,10"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.6" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================== BODY ============================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================ SIDEBAR ============================ -->
            <Border Grid.Column="0" Background="{StaticResource Suite.SidebarBg}"
                    BorderBrush="{StaticResource Suite.Hairline}" BorderThickness="0,0,1,0">
                <Grid Margin="12,16,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="10,6,10,14">
                        <TextBlock Text="O P E R A T I O N S" Style="{StaticResource Suite.MonoLabel}"
                                   FontSize="9.5" VerticalAlignment="Center" />
                        <Border HorizontalAlignment="Right" Background="#109DB1D2"
                                BorderBrush="{StaticResource Suite.Hairline}" BorderThickness="1"
                                CornerRadius="6" Padding="7,3"
                                Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVisConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="LockOutline" Width="9" Height="9"
                                                            Foreground="{StaticResource Suite.MistDim}"
                                                            VerticalAlignment="Center" />
                                <TextBlock Text="LOCKED" FontFamily="{StaticResource Suite.Mono}" FontSize="9"
                                           Foreground="{StaticResource Suite.MistDim}" Margin="5,0,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Nav -->
                    <StackPanel Grid.Row="1">
                        <Button Style="{StaticResource Suite.NavItem}" Command="{Binding NavigateMetarsCommand}"
                                Tag="{Binding Navigation.Current, Converter={StaticResource EqualsParameterConverter}, ConverterParameter=Metars}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="WeatherPartlyCloudy" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="METARs" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Suite.NavItem}" Command="{Binding NavigatePilotCentreCommand}"
                                Tag="{Binding Navigation.Current, Converter={StaticResource EqualsParameterConverter}, ConverterParameter=PilotCentre}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="AccountOutline" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="Pilot Centre" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Suite.NavItem}" Command="{Binding NavigateBookingsCommand}"
                                Tag="{Binding Navigation.Current, Converter={StaticResource EqualsParameterConverter}, ConverterParameter=Bookings}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="TicketConfirmationOutline" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="Bookings" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Suite.NavItem}" Command="{Binding NavigateBriefingCommand}"
                                Tag="{Binding Navigation.Current, Converter={StaticResource EqualsParameterConverter}, ConverterParameter=Briefing}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ClipboardTextOutline" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="Briefing" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Rectangle Height="1" Fill="{StaticResource Suite.Hairline}" Margin="12,10" />

                        <Button Style="{StaticResource Suite.NavItem}" Command="{Binding NavigateAcarsCommand}"
                                Tag="{Binding Navigation.Current, Converter={StaticResource EqualsParameterConverter}, ConverterParameter=Acars}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="RadioTower" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="ACARS" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Suite.NavItem}" Command="{Binding NavigateDebriefingCommand}"
                                Tag="{Binding Navigation.Current, Converter={StaticResource EqualsParameterConverter}, ConverterParameter=Debriefing}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ChartLine" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="Debriefing" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Suite.NavItem}" Command="{Binding NavigateOutstationCommand}"
                                Tag="{Binding Navigation.Current, Converter={StaticResource EqualsParameterConverter}, ConverterParameter=Outstation}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="MapMarkerOutline" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="Outstation Flights" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Suite.NavItem}" Command="{Binding NavigateLogbookCommand}"
                                Tag="{Binding Navigation.Current, Converter={StaticResource EqualsParameterConverter}, ConverterParameter=Logbook}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="NotebookOutline" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="Logbook" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Pilot card (click -> Pilot Centre) -->
                    <Border Grid.Row="2" Background="#B3081628" BorderBrush="{StaticResource Suite.Hairline}"
                            BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,12,0,0"
                            Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding NavigatePilotCentreCommand}" />
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9"
                                    Background="{StaticResource Suite.AvatarBg}"
                                    BorderBrush="{StaticResource Suite.HairlineStrong}" BorderThickness="1">
                                <Grid>
                                    <iconPacks:PackIconMaterial Kind="AccountOutline" Width="17" Height="17"
                                                                Foreground="{StaticResource Suite.Mist}"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVisConverter}}" />
                                    <TextBlock Text="{Binding PilotInitials}"
                                               FontFamily="{StaticResource Suite.Display}" FontWeight="Bold"
                                               FontSize="13" Foreground="#FFCFE0FF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisConverter}}" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PilotCardName}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Suite.Cloud}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding PilotCardSub}" FontFamily="{StaticResource Suite.Mono}"
                                           FontSize="9.5" Foreground="{StaticResource Suite.MistDim}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource Suite.IconBtn}"
                                    Command="{Binding LogoutCommand}" ToolTip="Sign out"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisConverter}}">
                                <iconPacks:PackIconMaterial Kind="Logout" Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================ ACTIVE PAGE ============================ -->
            <Grid Grid.Column="1">
                <!-- .main background: ink gradient + faint royal glow top-right -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF061328" Offset="0" />
                            <GradientStop Color="#FF040D1C" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush Center="0.88,-0.1" GradientOrigin="0.88,-0.1" RadiusX="0.7" RadiusY="0.6">
                            <GradientStop Color="#1A2563D6" Offset="0" />
                            <GradientStop Color="#002563D6" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <ContentControl Content="{Binding Navigation.CurrentView}" />
            </Grid>
        </Grid>

        <!-- ============================ STATUS BAR ============================ -->
        <Border Grid.Row="2" Background="{StaticResource Suite.StatusbarBg}"
                BorderBrush="{StaticResource Suite.Hairline}" BorderThickness="0,1,0,0">
            <Grid TextElement.FontFamily="{StaticResource Suite.Mono}" TextElement.FontSize="10.5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- API -->
                <Border Grid.Column="0" BorderBrush="{StaticResource Suite.Hairline}" BorderThickness="0,0,1,0"
                        Padding="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Suite.Amber}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsApiOnline}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Suite.Green}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Foreground="{StaticResource Suite.Mist}" Margin="8,0,0,0">
                            <Run Text="API" /><Run Text=" " /><Run
                                Text="{Binding ServerStatusText, Mode=OneWay}"
                                Foreground="{StaticResource Suite.Cloud}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Sim -->
                <Border Grid.Column="1" BorderBrush="{StaticResource Suite.Hairline}" BorderThickness="0,0,1,0"
                        Padding="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Suite.Crimson}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSimConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Suite.Green}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Foreground="{StaticResource Suite.Mist}" Margin="8,0,0,0">
                            <Run Text="FSUIPC" /><Run Text=" " /><Run
                                Text="{Binding SimStatusText, Mode=OneWay}"
                                Foreground="{StaticResource Suite.Cloud}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ACARS -->
                <Border Grid.Column="2" BorderBrush="{StaticResource Suite.Hairline}" BorderThickness="0,0,1,0"
                        Padding="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Suite.Amber}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAcarsActive}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Suite.Green}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Foreground="{StaticResource Suite.Mist}" Margin="8,0,0,0">
                            <Run Text="ACARS" /><Run Text=" " /><Run
                                Text="{Binding AcarsStatusText, Mode=OneWay}"
                                Foreground="{StaticResource Suite.Cloud}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Hub -->
                <Border Grid.Column="3" BorderBrush="{StaticResource Suite.Hairline}" BorderThickness="0,0,1,0"
                        Padding="16,0">
                    <TextBlock Foreground="{StaticResource Suite.Mist}" VerticalAlignment="Center">
                        <Run Text="HUB" /><Run Text=" " /><Run
                            Text="{Binding HubText, Mode=OneWay}"
                            Foreground="{StaticResource Suite.Cloud}" FontWeight="SemiBold" />
                    </TextBlock>
                </Border>

                <!-- UTC -->
                <Border Grid.Column="5" BorderBrush="{StaticResource Suite.Hairline}" BorderThickness="1,0,0,0"
                        Padding="16,0">
                    <TextBlock Foreground="{StaticResource Suite.Mist}" VerticalAlignment="Center">
                        <Run Text="UTC" /><Run Text=" " /><Run
                            Text="{Binding ZuluText, Mode=OneWay}"
                            Foreground="{StaticResource Suite.Cloud}" FontWeight="SemiBold" />
                    </TextBlock>
                </Border>

                <!-- Ping -->
                <Border Grid.Column="6" BorderBrush="{StaticResource Suite.Hairline}" BorderThickness="1,0,0,0"
                        Padding="16,0">
                    <TextBlock Foreground="{StaticResource Suite.Mist}" VerticalAlignment="Center">
                        <Run Text="PING" /><Run Text=" " /><Run
                            Text="{Binding PingText, Mode=OneWay}"
                            Foreground="{StaticResource Suite.Cloud}" FontWeight="SemiBold" />
                    </TextBlock>
                </Border>

                <!-- Copyright -->
                <Border Grid.Column="7" BorderBrush="{StaticResource Suite.Hairline}" BorderThickness="1,0,0,0"
                        Padding="16,0">
                    <TextBlock Text="© Air Serbia Virtual — community build"
                               Foreground="{StaticResource Suite.Mist}" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
