@page "/portal"

<PageTitle>Pilot portal — Air Serbia Virtual</PageTitle>

<section class="mx-auto max-w-7xl px-4 sm:px-6 py-24 text-center">
    <div class="mx-auto h-20 w-20 rounded-full panel grid place-items-center mb-8">
        <svg class="h-9 w-9 text-royal-bright" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 3" />
        </svg>
    </div>
    <h1 class="font-display font-extrabold text-3xl text-white">The pilot portal is on final approach</h1>
    <p class="mt-4 text-mist max-w-md mx-auto text-[14.5px] leading-relaxed">
        Dashboard, booking, briefing and your logbook are landing here in the next phase.
        Until then, the desktop ACARS client covers the full flight workflow.
    </p>
    <span class="inline-block mt-7 rounded-lg border hairline bg-ink-800/60 px-3.5 py-1.5 font-mono text-[10px] tracking-[0.2em] text-mist">
        PHASE W3 · PILOT PORTAL
    </span>
</section>
