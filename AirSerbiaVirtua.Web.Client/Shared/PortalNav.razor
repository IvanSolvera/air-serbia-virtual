@inject PortalSession Session
@inject IPortalApi Api
@inject NavigationManager Nav

<div class="mb-10">
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="h-12 w-12 rounded-xl bg-gradient-to-br from-royal-deep to-ink-900 border hairline grid place-items-center font-display font-extrabold text-[15px] text-sky-200">
                @Initials
            </div>
            <div>
                <p class="font-display font-bold text-white text-[16px] leading-tight">
                    @(Session.Pilot?.Callsign ?? "—") <span class="text-mist/60 font-sans font-medium">·</span> @(Session.Pilot?.Name ?? "")
                </p>
                <p class="font-mono text-[10.5px] tracking-wider text-mist/70 mt-0.5">
                    @(Session.Pilot?.RankName ?? "—") · @(Session.Pilot?.HubId ?? "—") · @(Session.Pilot?.TotalHours.ToString("0.0") ?? "0") H
                </p>
            </div>
        </div>
        <button @onclick="SignOutAsync"
                class="rounded-lg panel px-4 py-2 text-[12.5px] font-bold text-mist hover:text-white transition">
            Sign out
        </button>
    </div>

    <nav class="mt-7 flex flex-wrap gap-1 border-b hairline text-[13.5px] font-semibold text-mist">
        <NavLink href="portal" Match="NavLinkMatch.All" class="tab-btn px-3.5 py-3 hover:text-white transition-colors" ActiveClass="active">Dashboard</NavLink>
        <NavLink href="portal/book" class="tab-btn px-3.5 py-3 hover:text-white transition-colors" ActiveClass="active">Book a flight</NavLink>
        <NavLink href="portal/briefing" class="tab-btn px-3.5 py-3 hover:text-white transition-colors" ActiveClass="active">Briefing</NavLink>
        <NavLink href="portal/logbook" class="tab-btn px-3.5 py-3 hover:text-white transition-colors" ActiveClass="active">Logbook</NavLink>
        <NavLink href="portal/profile" class="tab-btn px-3.5 py-3 hover:text-white transition-colors" ActiveClass="active">Profile</NavLink>
    </nav>
</div>

@code {
    private string Initials
    {
        get
        {
            var name = Session.Pilot?.Name ?? "";
            var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length >= 2) return $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[^1][0])}";
            if (parts.Length == 1 && parts[0].Length >= 2) return parts[0][..2].ToUpper();
            return "··";
        }
    }

    private async Task SignOutAsync()
    {
        await Api.LogoutAsync();
        Nav.NavigateTo("portal/login");
    }
}
